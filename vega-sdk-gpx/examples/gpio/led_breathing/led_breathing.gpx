// ============================================================================
// VEGA RISC-V SDK Example in GPX: LED Breathing Effect
// Target: THEJAS32 / ARIES v2.0 Board
// Demonstrates: Software PWM pulse modulation for smooth LED fading
// ============================================================================

#include <vega/bsp.gpx>
#include <vega/led.gpx>
#include <vega/timer.gpx>

fn breathe_led(pin: int, cycles: int) -> int {
    let period = 2000; // 2ms total PWM period (500Hz)
    let step = 0;

    while step < cycles {
        // Inhale: fade in (duty cycle increases from 0% to 100%)
        let duty = 50;
        while duty < period {
            on_LED(pin);
            udelay(duty);
            off_LED(pin);
            udelay(period - duty);
            duty = duty + 100;
        }

        // Hold peak briefly
        on_LED(pin);
        delay_ms(50);

        // Exhale: fade out (duty cycle decreases from 100% to 0%)
        duty = period - 50;
        while duty > 50 {
            on_LED(pin);
            udelay(duty);
            off_LED(pin);
            udelay(period - duty);
            duty = duty - 100;
        }

        // Hold low briefly
        off_LED(pin);
        delay_ms(50);

        step = step + 1;
    }
    return 0;
}

fn main() -> int {
    print("========================================");
    print("  VEGA RISC-V GPX: LED Breathing Demo   ");
    print("========================================");

    let led_pin = 31; // On-board LED pin
    print("Breathing LED on GPIO pin 31...");
    breathe_led(led_pin, 3);

    print("LED Breathing Demo Completed.");
    return 0;
}
