{
  "name": "gpx-lang",
  "displayName": "GPX Language Support",
  "description": "GPX language syntax highlighting and snippets",
  "version": "0.3.0",
  "publisher": "gpx",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gpx",
        "extensions": [
          ".gpx"
        ],
        "aliases": [
          "GPX",
          "gpx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gpx",
        "path": "./syntaxes/gpx.tmLanguage.json",
        "scopeName": "source.gpx"
      }
    ],
    "snippets": [
      {
        "language": "gpx",
        "path": "./snippets/gpx.json"
      }
    ]
  }
}