// -------------------------------------------------------------
// GPX Language Example 10: Dynamic Memory & Heap Data Structures
// Demonstrates:
// 1. Including standard memory library: #include <memory.gpx>
// 2. Compile-time sizeof operator on types, structs, and pointers
// 3. Dynamic memory allocation with malloc and zero-fill with memset
// 4. Dynamic array indexing and manipulation (arr[i])
// 5. Dynamic buffer resizing with realloc
// 6. Singly-linked list node allocation on heap with pointer chaining
// 7. Safe deallocation using free()
// -------------------------------------------------------------

#include <memory.gpx>

struct Node {
    val: int,
    next: *Node
}

struct Point3D {
    x: int,
    y: int,
    z: int
}

fn print_separator(): void {
    printf("--------------------------------------------------\n");
}

fn main(): int {
    printf("=== GPX v0.6.0: Dynamic Memory Management Demo ===\n\n");

    // 1. Compile-Time sizeof Operator
    printf("1. Compile-Time Type Sizes (in bytes):\n");
    printf("   sizeof(byte)   = %d\n", sizeof(byte));
    printf("   sizeof(short)  = %d\n", sizeof(short));
    printf("   sizeof(int)    = %d\n", sizeof(int));
    printf("   sizeof(long)   = %d\n", sizeof(long));
    printf("   sizeof(double) = %d\n", sizeof(double));
    printf("   sizeof(*void)  = %d\n", sizeof(*void));
    printf("   sizeof(Point3D)= %d\n", sizeof(Point3D));
    printf("   sizeof(Node)   = %d\n\n", sizeof(Node));
    print_separator();

    // 2. Dynamic Array Allocation & Indexing
    printf("2. Dynamic Array Allocation (malloc):\n");
    let count: int = 5;
    let arr: *int = malloc(sizeof(int) * count);
    if arr == null {
        printf("Failed to allocate dynamic array!\n");
        return 1;
    }

    for i in 0..count {
        arr[i] = (i + 1) * 10;
    }

    printf("   Array elements: ");
    for i in 0..count {
        printf("%d ", arr[i]);
    }
    printf("\n\n");
    print_separator();

    // 3. Dynamic Array Resizing (realloc)
    printf("3. Dynamic Array Resizing (realloc to 8 items):\n");
    let new_count: int = 8;
    arr = realloc(arr, sizeof(int) * new_count);
    arr[5] = 60;
    arr[6] = 70;
    arr[7] = 80;

    printf("   Resized array elements: ");
    for i in 0..new_count {
        printf("%d ", arr[i]);
    }
    printf("\n");
    free(arr);
    printf("   Memory successfully freed.\n\n");
    print_separator();

    // 4. Singly Linked List on Heap
    printf("4. Singly Linked List on Heap:\n");
    let head: *Node = malloc(sizeof(Node));
    let second: *Node = malloc(sizeof(Node));
    let third: *Node = malloc(sizeof(Node));

    head->val = 100;
    head->next = second;

    second->val = 200;
    second->next = third;

    third->val = 300;
    third->next = null;

    let curr: *Node = head;
    let list_sum: int = 0;
    printf("   Traversing nodes: ");
    while curr != null {
        printf("%d -> ", curr->val);
        list_sum = list_sum + curr->val;
        curr = curr->next;
    }
    printf("NULL\n");
    printf("   Total list sum = %d\n", list_sum);

    // Free all nodes
    free(head);
    free(second);
    free(third);
    printf("   Linked list nodes freed.\n\n");
    print_separator();

    printf("Dynamic Memory & Data Structures Demo completed successfully!\n");
    return 0;
}
