// ==============================================================================
// GPX Module Example: 2D Geometry & Vector Math (42_module_geometry.gpx)
// ==============================================================================

struct Vector2D {
    x: double,
    y: double,
}

fn (v: *Vector2D) length_squared() -> double {
    return v->x * v->x + v->y * v->y;
}

fn (v: *Vector2D) translate(dx: double, dy: double) {
    v->x = v->x + dx;
    v->y = v->y + dy;
}

fn create_vector(x: double, y: double) -> Vector2D {
    return Vector2D { x: x, y: y };
}

