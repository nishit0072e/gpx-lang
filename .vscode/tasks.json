{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GPX: Run File",
      "type": "shell",
      "command": "gpx \"${file}\" --run",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "GPX: Interactive Step Debugger",
      "type": "shell",
      "command": "gpx \"${file}\" --step",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
